# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (plan invitations). Delivery is optional: without RESEND_API_KEY the
# invite link is logged and can be copied from the members page instead.
RESEND_API_KEY=
INVITATION_EMAIL_FROM="Crest <onboarding@resend.dev>"
# Absolute base URL used to build invite links (falls back to the request host).
NEXT_PUBLIC_APP_URL=

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public HTTPS URL for webhooks (use a tunnel in dev, e.g. ngrok)
PLAID_WEBHOOK_URL=
