# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public HTTPS URL for webhooks (use a tunnel in dev, e.g. ngrok)
PLAID_WEBHOOK_URL=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use if this app is misbehaving, e.g. mailto:you@example.com
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
